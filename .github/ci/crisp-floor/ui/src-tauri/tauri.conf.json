{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crisp",
  "version": "0.1.0",
  "identifier": "host.crisp.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Crisp",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$DESKTOP/**",
            "$DOCUMENT/**",
            "$DOWNLOAD/**",
            "$MOVIE/**",
            "$PICTURE/**",
            "$TEMP/**",
            "/Volumes/**",
            "/Users/Shared/**",
            "/private/tmp/**"
          ],
          "requireLiteralLeadingDot": true
        }
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8799 ws://127.0.0.1:8799 asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://127.0.0.1:8799",
        "media-src": "'self' asset: http://asset.localhost blob: data: http://127.0.0.1:8799",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/upscayl-bin": "upscayl-bin",
      "resources/crisp-vision": "crisp-vision",
      "resources/models": "models",
      "resources/music": "music",
      "resources/run_seedvr2.py": "run_seedvr2.py"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://crispvideo.app/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4MkE1QTMwMjE1NTQ3OUMKUldTY1IxVWhNRm9xYU5ySmU4YzIyUGkzT0F3RlhKUjlIWHBPVm5jNzJZZVh3VFhTVHg3dm9RNGwK"
    }
  }
}
