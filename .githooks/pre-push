#!/bin/sh
# Refuse to push a site that advertises a different version than it ships.
#
# THIS EXISTS BECAUSE INSTRUCTION DID NOT WORK. index.html's JSON-LD
# softwareVersion drifted from latest.json three times in one evening —
# 0.1.810 vs 0.1.813, 0.1.813 vs 0.1.815, 0.1.815 vs 0.1.816 — each time
# through a ship done by hand rather than through scripts/publish_release.sh.
#
# The first fix patched publish_release.sh to derive the field from the built
# app's Info.plist. It did not hold, because the path that causes this never
# calls that script: the "<version>: ship artifacts" commits come from a session
# shipping by hand. Patching one script cannot cover a path that does not invoke
# it, so this moves the check to the one place every path passes through.
#
# latest.json is the source of truth: every ship writes it and the Tauri updater
# reads it, so it cannot silently be wrong without the updater breaking too.
# index.html is the copy, and the copy is what rots.
#
# The first version of THIS hook used __file__ to find the repo, which is
# "<stdin>" inside a heredoc, so it resolved to nothing, took its own
# "not my layout" branch and passed silently while the drift was present. Git
# runs hooks from the top of the working tree, so cwd is the answer — and a
# missing file now FAILS instead of being waved through, because a gate that
# cannot see its subject must never report success.
#
# ops/drift.py still checks this against the LIVE url as a backstop. That
# catches a wrong number after publication; this catches it before.
#
# Bypass with --no-verify if you genuinely mean it.

python3 - <<'PY' || exit 1
import json, pathlib, re, sys

root = pathlib.Path.cwd()
latest, index = root / "latest.json", root / "index.html"

missing = [p.name for p in (latest, index) if not p.is_file()]
if missing:
    print(f"pre-push BLOCKED: cannot find {', '.join(missing)} in {root}.")
    print("  This gate compares them and it will not pass when it cannot look.")
    sys.exit(1)

shipped = json.loads(latest.read_text()).get("version", "")
m = re.search(r'"softwareVersion":\s*"([^"]*)"', index.read_text())
if not m:
    print("pre-push BLOCKED: index.html has no softwareVersion field, so the "
          "gate cannot check it. Restore the field or remove this hook "
          "deliberately — do not leave it blind.")
    sys.exit(1)

advertised = m.group(1)
if not shipped:
    print("pre-push BLOCKED: latest.json has no version.")
    sys.exit(1)

if advertised != shipped:
    print(f"pre-push BLOCKED: index.html advertises {advertised}, "
          f"latest.json ships {shipped}.")
    print("  Every visitor and every crawler would read the wrong version.")
    print("  Fix it by shipping through scripts/publish_release.sh, which sets")
    print("  the field from the built app, or by correcting index.html by hand.")
    sys.exit(1)

print(f"pre-push: version sync ok ({shipped})")
PY

# No third-party host may load for a visitor who did not ask for one. On
# 2026-08-17 the homepage fired three cross-origin scripts — two Plausible
# installs and usesled.com — directly above a hero reading "Nothing uploaded".
# A comment above the tag argued the privacy claim was "scoped to the APP, not
# this website", which is how it survived review. Hence a gate.
python3 "$(dirname "$0")/../_tools/gate_thirdparty.py" || exit 1

# ...and every exemption THAT gate grants must still describe real code.
#
# The gate above carries per-file exemptions, each keyed to a marker, and it
# PRINTS the reason for each one on every run. On 2026-09-15 founding.js stopped
# making the call its exemption excused, and the gate went on printing that the
# call happens — asserting deleted behaviour to anyone auditing privacy, and
# pre-approving that host for the day it came back. That gate's own docstring
# names this ("a dead exemption is worse than none") and instruction alone did
# not hold it, which is the same reason the gate above exists at all.
python3 "$(dirname "$0")/../_tools/gate_exemptions_live.py" || exit 1

# ...and no JSON-LD block may declare a key twice. page_dates.py appended a second
# dateModified to 16 pages because its regex could not see the one already there; a JSON
# parser keeps the LAST, so the stale date won and crawlers read it while the correct value
# sat in the same object being ignored. Valid JSON, valid-looking file, wrong structured data.
python3 "$(dirname "$0")/../_tools/gate_jsonld_duplicate_keys.py" || exit 1

# ...and every claim the site makes about the ENGINE must still be true of the engine.
#
# THIS IS THE GATE TODAY'S NEAR-MISS ASKED FOR. On 2026-09-15 four how-to pages were
# rewritten and pushed, and the check that reads site copy against engine constants lives in
# the CRISP suite — which a site push never ran. It was only seen hours later, in a full
# 22-minute suite run done for an unrelated reason. That time the page turned out to be right
# and the test wrong, but nothing about the sequence depended on which way it went: a genuinely
# false price, speed range, volume range or capability claim would have shipped exactly the
# same way, and the site's own gates would all have passed it.
#
# The site is its own git repo, so "the suite will catch it" is false here — there is no push
# path from this repo into that suite. 68 tests, ~3 s, so there is no cost argument either.
#
# Selected by what they read rather than by name (every one of them resolves ROOT/"site"), so a
# new site-vs-engine test is covered the day it is written and cannot be forgotten by this list.
#
# Blocking when it cannot look, not skipping: this file already argues that case for the
# version gate ("a gate that cannot see its subject must never report success"), and a silent
# skip here is precisely how the checks got bypassed in the first place. --no-verify if you
# genuinely mean it.
CRISP_ROOT="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)"
if [ ! -d "$CRISP_ROOT/tests" ]; then
  echo "pre-push BLOCKED: no crisp tests/ above this repo ($CRISP_ROOT)."
  echo "  The site-vs-engine claim checks live there and this gate will not pass blind."
  exit 1
fi
if [ ! -x /opt/homebrew/bin/pytest ]; then
  echo "pre-push BLOCKED: /opt/homebrew/bin/pytest is missing, so the site-vs-engine"
  echo "  claim checks cannot run. Install it or push with --no-verify deliberately."
  exit 1
fi
SITE_TESTS=$(grep -rl 'SITE = ROOT / "site"' "$CRISP_ROOT/tests" 2>/dev/null)
if [ -z "$SITE_TESTS" ]; then
  echo "pre-push BLOCKED: found no site-vs-engine tests to run."
  echo "  They are selected by the literal 'SITE = ROOT / \"site\"'. If that line was"
  echo "  reworded, fix this selector — do not leave the gate matching nothing."
  exit 1
fi
# shellcheck disable=SC2086
/opt/homebrew/bin/pytest -q $SITE_TESTS > /tmp/crisp_site_gate.$$ 2>&1 || {
  echo "pre-push BLOCKED: the site contradicts the engine."
  tail -25 /tmp/crisp_site_gate.$$
  rm -f /tmp/crisp_site_gate.$$
  exit 1
}
echo "pre-push: site-vs-engine claims ok ($(echo "$SITE_TESTS" | wc -l | tr -d ' ') files)"

# ── SIXTH GATE: the price this site advertises must be the price the till charges ───────────
# The five gates above compare this site to ITSELF and to the engine. None of them has ever
# looked at the checkout. So the site, the app and the tests could agree perfectly on $129 while
# Dodo charged something else, and every gate stayed green — the customer would be the one to
# find out, with their own money.
#
# ⚠️ SKIPPED, NOT FAILED, WITHOUT NETWORK. A deploy from a train is not evidence of a wrong
# price, and a gate that blocks every offline push is a gate someone removes.
if [ -x "$CRISP_ROOT/scripts/verify_checkout.py" ]; then
  if python3 - <<'NETCHK' >/dev/null 2>&1
import socket,sys
try: socket.create_connection(("checkout.dodopayments.com",443),timeout=6).close()
except Exception: sys.exit(1)
NETCHK
  then
    python3 "$CRISP_ROOT/scripts/verify_checkout.py" || exit 1
  else
    echo "pre-push: checkout unreachable — price-vs-till check SKIPPED (not a pass)"
  fi
fi
rm -f /tmp/crisp_site_gate.$$
